+	case IPC_MACRO_UNLESS: {
+		char *expression = strchr(msg.data, '\n');
+		int found = 0;
+		if (!expression || msg.timeout) {
+			send_fail(con, "invalid guarded macro");
+			return;
+		}
+		*expression++ = 0;
+		for (ent = configs; ent; ent = ent->next) {
+			struct keyboard *kbd = ent->kbd;
+			for (size_t i = 0; i < kbd->config.nr_layers; i++) {
+				if (strcmp(kbd->config.layers[i].name, msg.data))
+					continue;
+				found = 1;
+				if (kbd->layer_state[i].active) {
+					struct ipc_message busy = {.type = IPC_BUSY};
+					xwrite(con, &busy, sizeof busy);
+					close(con);
+					return;
+				}
+			}
+		}
+		if (!found) {
+			send_fail(con, "unknown guard layer");
+			return;
+		}
+		msg.sz -= expression - msg.data;
+		memmove(msg.data, expression, msg.sz + 1);
+		/* No device event runs between this check and macro execution. */
+	}
+		/* fall through */
