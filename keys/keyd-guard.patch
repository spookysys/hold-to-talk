+/* Execute only if the named layer is inactive in every configuration. */
+static int cmd_do_unless(int argc, char *argv[])
+{
+	char buf[MAX_IPC_MESSAGE_SIZE];
+	if (argc < 3 || strlen(argv[1]) >= MAX_LAYER_NAME_LEN) {
+		fprintf(stderr, "usage: keyd do-unless LAYER EXPRESSION\n");
+		return 1;
+	}
+	size_t prefix = strlen(argv[1]) + 1;
+	memcpy(buf, argv[1], prefix - 1);
+	buf[prefix - 1] = '\n';
+	size_t sz = sizeof buf - prefix;
+	read_input(argc - 2, argv + 2, buf + prefix, &sz);
+	return ipc_exec(IPC_MACRO_UNLESS, buf, prefix + sz, 0);
+}
