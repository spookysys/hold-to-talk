[Unit]
Description=talk key helper: reports holds of the launch key to user %i
Requires=talk-keys@%i.socket keyd.service
After=keyd.service

[Service]
ExecStart=/usr/local/libexec/talk-keys
Restart=on-failure

# A throwaway user with two groups: keyd for `keyd listen` and `keyd do`,
# input for the keyd virtual keyboard. No root, no other files.
DynamicUser=yes
SupplementaryGroups=keyd input

DevicePolicy=closed
DeviceAllow=char-input r
DeviceAllow=/dev/ptmx rw
DeviceAllow=char-pts rw
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
UMask=0077
MemoryMax=32M
