[Unit]
Description=voice: hold the launch key and speak
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/voice run
# Speech must decode faster than it arrives, also when other programs keep
# the CPU busy. The session slice has a higher CPU weight than the
# applications' slice; GNOME runs its input method there too. On battery,
# with every core busy, it kept decoding at 0.96 s per second of speech.
Slice=session.slice
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
